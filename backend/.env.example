PORT=4000
CHECKOUT_TAX_RATE_BASIS_POINTS=1100
CHECKOUT_ITEM_WEIGHT_GRAMS=500
VOUCHER_DEFAULT_PERCENTAGE=20
VOUCHER_DEFAULT_MINIMUM_SUBTOTAL=200000
VOUCHER_DEFAULT_DURATION_DAYS=7
VOUCHER_DEFAULT_MAXIMUM_DISCOUNT=30000
VOUCHER_CODE_LENGTH_MIN=4
VOUCHER_CODE_LENGTH_MAX=6
# Checkout and ERP fulfilment are limited to JNE and J&T by the approved
# Phase 4 operating policy; widening that set requires a reviewed policy change.
INVENTORY_IMPORT_ROLLBACK_HOURS=24
CANCELLATION_REVIEW_DAYS=3
REFUND_REVIEW_DAYS=3
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://nilam:nilam_local_dev@localhost:5435/nilam
ERP_BOOTSTRAP_EMAIL=erp-admin@example.test
ERP_BOOTSTRAP_PASSWORD=development-only-password-at-least-12-characters
ERP_PUBLIC_URL=http://localhost:4000
ERP_IDENTITY_TOKEN_EXPIRY_HOURS=24
# A base64-encoded 32-byte key used only to encrypt staff TOTP secrets at rest.
# Generate separately for each environment, store outside Git, and never rotate
# without a recovery/re-enrollment plan.
ERP_MFA_ENCRYPTION_KEY=
# In production this defaults to enabled. Privileged ERP mutations require an
# enrolled and verified staff TOTP factor when this is true.
ERP_REQUIRE_MFA_FOR_PRIVILEGED=false
MINIO_ENDPOINT=http://192.168.100.36:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=replace-with-bucket-scoped-access-key
MINIO_SECRET_KEY=replace-with-bucket-scoped-secret-key
MEDIA_BUCKET=topan-media-prod
MEDIA_PUBLIC_BASE_URL=https://media-topan.fluxorastudio.id
